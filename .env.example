# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# Anything prefixed VITE_ is inlined into the public JS bundle. Only ever put
# the anon key here. The service_role key must NEVER appear in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The FastAPI backend. Local development defaults to http://localhost:8000;
# in production this is the Railway URL, e.g. https://blujeansz-api.up.railway.app
VITE_API_URL=http://localhost:8000
